# Application
APP_ENV=development
APP_PORT=8080

# PostgreSQL
DATABASE_URL=postgres://postgres:secret@localhost:5432/iot_platform?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-this-to-a-random-32-byte-secret-string-here
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
