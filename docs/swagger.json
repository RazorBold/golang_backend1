                "description": {
                    "type": "string",
                    "maxLength": 500
                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 2
                }
            }
        },
        "model.UpdateDeviceRequest": {
            "type": "object",
            "properties": {
                "metadata": {
                    "type": "object"
                },
                "name": {
                    "type": "string",
