# Application
APP_ENV=development
APP_PORT=8080

# PostgreSQL — sesuai docker-compose
DATABASE_URL=postgres://postgres:secret@localhost:5432/iot_platform?sslmode=disable

# Redis — sesuai docker-compose
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT — ganti di production!
JWT_SECRET=dev-secret-change-this-in-production-32chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# RabbitMQ — sesuai docker-compose
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
