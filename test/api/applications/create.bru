meta {
  name: Create Application
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/applications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Smart Farm",
    "description": "IoT sensors for farm monitoring"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("appId", res.body.data.id);
    bru.setEnvVar("apiKey", res.body.data.api_key);
  }
}
