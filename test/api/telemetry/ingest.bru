meta {
  name: Ingest Telemetry
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/ingest/{{deviceId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "temperature": 28.5,
    "humidity": 60.2,
    "battery": 95,
    "timestamp": "2026-05-19T14:00:00Z"
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("status ok", function() {
    expect(res.body.data.status).to.equal("ok");
  });
}
